diff --git a/src/cvnx_prof.h b/src/cvnx_prof.h
new file mode 100644
index 00000000..6a962268
--- /dev/null
+++ b/src/cvnx_prof.h
@@ -0,0 +1,77 @@
+#pragma once
+// Switch port profiling of the gfx thread: time inside GL calls (by function) and in a few renderer zones, read by
+// the perf line in switch/render_gliden64.cpp. Plain counters: GLideN64 runs on one thread here (ThreadedVideo off).
+#include <cstdint>
+#if !defined(__aarch64__)
+#include <chrono>
+#endif
+
+namespace cvnxprof {
+
+inline uint64_t ticks() {
+#if defined(__aarch64__)
+    uint64_t value;
+    asm volatile("mrs %0, cntpct_el0" : "=r"(value));
+    return value;
+#else
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count() / 52;
+#endif
+}
+
+struct Slot {
+    const char* name;
+    uint64_t ticks;
+    uint32_t calls;
+};
+
+enum Zone { ZONE_TEXTURES, ZONE_DRAW, ZONE_SWAP, ZONE_SHADER_SAVE, ZONE_VTX, ZONE_TRIGEN, ZONE_DLIST, ZONE_COUNT };
+
+constexpr int MAX_SLOTS = 160;
+extern Slot slots[MAX_SLOTS];
+extern int slot_count;
+extern uint64_t gl_ticks;
+extern uint64_t zone_ticks[ZONE_COUNT];
+extern uint64_t zone_gl_ticks[ZONE_COUNT];
+extern int zone_depth[ZONE_COUNT];
+
+int slot(const char* name);
+
+struct GlTimer {
+    int index;
+    uint64_t start;
+
+    explicit GlTimer(int i) : index(i), start(ticks()) {}
+
+    ~GlTimer() {
+        const uint64_t spent = ticks() - start;
+        if (index >= 0) {
+            slots[index].ticks += spent;
+            slots[index].calls++;
+        }
+        gl_ticks += spent;
+    }
+};
+
+// Inclusive time of a zone and the GL time inside it; a zone entered again inside itself counts once.
+struct ZoneTimer {
+    int zone;
+    uint64_t start;
+    uint64_t gl_start;
+
+    explicit ZoneTimer(int z) : zone(z), start(ticks()), gl_start(gl_ticks) {
+        zone_depth[zone]++;
+    }
+
+    ~ZoneTimer() {
+        if (--zone_depth[zone] == 0) {
+            zone_ticks[zone] += ticks() - start;
+            zone_gl_ticks[zone] += gl_ticks - gl_start;
+        }
+    }
+};
+
+}
+
+#define CVNX_GL(name) static const int cvnx_gl_slot_ = cvnxprof::slot(name); cvnxprof::GlTimer cvnx_gl_timer_(cvnx_gl_slot_)
+#define CVNX_ZONE(zone) cvnxprof::ZoneTimer cvnx_zone_timer_(cvnxprof::zone)
